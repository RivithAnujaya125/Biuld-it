# Server-only Gemini key (used by /api/generate and /api/verify).
# NEVER prefix with VITE_ — that would expose it to the browser bundle.
GEMINI_API_KEY=your_key_here

VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Optional hardening for the API routes:
# REQUIRE_AUTH=true  -> require Firebase ID token on /api/verify + /api/generate
# ALLOWED_ORIGIN=https://your-domain.com -> restrict CORS instead of '*'
# GITHUB_TOKEN=your_github_personal_access_token (raises GitHub limit 60 -> 5000 req/hr)
